@model BankApp.Core.Models.EWallet
@{
    ViewData["Title"] = $"Transfer from {Model.WalletName}";
    var userWallets = ViewBag.UserWallets as IEnumerable<BankApp.Core.Models.EWallet>;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Transfer Money</h4>
                    <small class="text-muted">From: @Model.WalletName (@Model.AvailableBalance.ToString("C"))</small>
                </div>
                <div class="card-body">
                    <div class="wallet-info mb-4">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            <strong>Available Balance:</strong> @Model.AvailableBalance.ToString("C")
                        </div>
                    </div>

                    <form asp-action="Transfer" asp-route-id="@Model.Id" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="mb-3">
                            <label for="toWalletId" class="form-label">To Wallet</label>
                            <select id="toWalletId" name="toWalletId" class="form-control" required>
                                <option value="">Select destination wallet</option>
                                @if (userWallets != null)
                                {
                                    foreach (var wallet in userWallets)
                                    {
                                        <option value="@wallet.Id">
                                            @wallet.WalletName (@wallet.AvailableBalance.ToString("C"))
                                        </option>
                                    }
                                }
                            </select>
                            <span class="text-muted small">Select which wallet to transfer money to</span>
                        </div>

                        <div class="mb-3">
                            <label for="amount" class="form-label">Transfer Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input type="number" id="amount" name="amount" class="form-control form-control-lg" 
                                       placeholder="0.00" step="0.01" min="1.00" max="@Model.AvailableBalance" required />
                            </div>
                            <span class="text-muted small">Maximum transferable: @Model.AvailableBalance.ToString("C")</span>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <input type="text" id="description" name="description" class="form-control" 
                                   placeholder="e.g., Monthly allowance, Gift transfer" />
                        </div>

                        <!-- Quick Amount Buttons -->
                        <div class="mb-4">
                            <label class="form-label">Quick Amounts</label>
                            <div class="quick-amounts">
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(50)">R50</button>
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(100)">R100</button>
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(200)">R200</button>
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(500)">R500</button>
                                <button type="button" class="btn btn-outline-primary" onclick="setMaxAmount()">Max</button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/EWallet/Details/@Model.Id" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-exchange-alt"></i> Transfer Money
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function setAmount(amount) {
        document.getElementById('amount').value = amount;
    }
    
    function setMaxAmount() {
        const maxAmount = @Model.AvailableBalance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        document.getElementById('amount').value = maxAmount;
    }
</script>

<style>
.card {
    border: none;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    border-radius: 16px;
}

.card-header {
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
    color: white;
    border-bottom: none;
    border-radius: 16px 16px 0 0;
    padding: 24px;
}

.wallet-info {
    background: var(--bg-color);
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 24px;
}

.form-control-lg {
    font-size: 1.25rem;
    padding: 12px 16px;
}

.quick-amounts {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.quick-amounts .btn {
    border-radius: 20px;
    font-size: 0.875rem;
    padding: 6px 16px;
}

.btn-lg {
    padding: 12px 32px;
    font-size: 1.125rem;
    border-radius: 12px;
}

.btn-primary {
    background: var(--primary-color);
    border-color: var(--primary-color);
}

.btn-primary:hover {
    background: var(--primary-color);
    opacity: 0.9;
}

.alert-info {
    background: #d1ecf1;
    border-color: #bee5eb;
    color: #0c5460;
}
</style>
