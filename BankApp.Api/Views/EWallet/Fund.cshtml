@model BankApp.Core.Models.EWallet
@{
    ViewData["Title"] = $"Fund {Model.WalletName}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Fund E-Wallet</h4>
                    <small class="text-muted">@Model.WalletName • @Model.WalletNumber</small>
                </div>
                <div class="card-body">
                    <div class="wallet-info mb-4">
                        <div class="text-center">
                            <div class="current-balance">
                                <small class="text-muted">Current Balance</small>
                                <div class="h3 mb-0">@Model.AvailableBalance.ToString("C")</div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Fund" asp-route-id="@Model.Id" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        
                        <div class="mb-3">
                            <label for="amount" class="form-label">Fund Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input type="number" id="amount" name="amount" class="form-control form-control-lg" 
                                       placeholder="0.00" step="0.01" min="1.00" required />
                            </div>
                            <span class="text-muted small">Enter amount to add to your wallet</span>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description (Optional)</label>
                            <input type="text" id="description" name="description" class="form-control" 
                                   placeholder="e.g., Salary deposit, Gift money" />
                        </div>

                        <!-- Quick Amount Buttons -->
                        <div class="mb-4">
                            <label class="form-label">Quick Amounts</label>
                            <div class="quick-amounts">
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(50)">R50</button>
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(100)">R100</button>
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(200)">R200</button>
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(500)">R500</button>
                                <button type="button" class="btn btn-outline-primary" onclick="setAmount(1000)">R1000</button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/EWallet/Details/@Model.Id" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-plus-circle"></i> Fund Wallet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function setAmount(amount) {
        document.getElementById('amount').value = amount;
    }
</script>

<style>
.card {
    border: none;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    border-radius: 16px;
}

.card-header {
    background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
    color: white;
    border-bottom: none;
    border-radius: 16px 16px 0 0;
    padding: 24px;
}

.wallet-info {
    background: var(--bg-color);
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 24px;
}

.current-balance .h3 {
    color: var(--primary-color);
    font-weight: 700;
}

.input-group-text {
    background: var(--primary-color);
    color: white;
    border: none;
}

.form-control-lg {
    font-size: 1.25rem;
    padding: 12px 16px;
}

.quick-amounts {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.quick-amounts .btn {
    border-radius: 20px;
    font-size: 0.875rem;
    padding: 6px 16px;
}

.btn-lg {
    padding: 12px 32px;
    font-size: 1.125rem;
    border-radius: 12px;
}

.btn-success {
    background: #10b981;
    border-color: #10b981;
}

.btn-success:hover {
    background: #059669;
    border-color: #059669;
}
</style>
