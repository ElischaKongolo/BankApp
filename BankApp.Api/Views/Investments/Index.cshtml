@model IEnumerable<BankApp.Core.Models.Investment>
@{
    ViewData["Title"] = "My Investments";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>My Investments</h2>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> New Investment
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <h4>No investments yet</h4>
                    <p>Start building your investment portfolio by creating your first investment.</p>
                    <a asp-action="Create" class="btn btn-primary">Create Investment</a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var investment in Model)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card investment-card">
                                <div class="card-body">
                                    <h5 class="card-title">@investment.Name</h5>
                                    <p class="card-text">
                                        <small class="text-muted">@investment.Type</small>
                                    </p>
                                    <div class="investment-details">
                                        <div class="row">
                                            <div class="col-6">
                                                <small class="text-muted">Initial</small>
                                                <div class="fw-bold">@investment.InitialAmount.ToString("C")</div>
                                            </div>
                                            <div class="col-6">
                                                <small class="text-muted">Current</small>
                                                <div class="fw-bold @(investment.ReturnPercentage >= 0 ? "text-success" : "text-danger")">
                                                    @investment.CurrentValue.ToString("C")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mt-2">
                                            <small class="text-muted">Return</small>
                                            <div class="fw-bold @(investment.ReturnPercentage >= 0 ? "text-success" : "text-danger")">
                                                @investment.ReturnPercentage.ToString("F2")%
                                            </div>
                                        </div>
                                        <div class="mt-2">
                                            <small class="text-muted">Risk Level</small>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar bg-@(investment.RiskLevel <= 3 ? "success" : investment.RiskLevel <= 7 ? "warning" : "danger")" 
                                                     style="width: @(investment.RiskLevel * 20)%"></div>
                                            </div>
                                            <small>@investment.RiskLevel/10</small>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <a asp-action="Details" asp-route-id="@investment.Id" class="btn btn-sm btn-outline-primary">View</a>
                                        <a asp-action="Edit" asp-route-id="@investment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Investment News</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h6>Latest Market Updates</h6>
                            <p>Stay informed with the latest investment news and market analysis.</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <a asp-action="News" class="btn btn-outline-primary">View All News</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.investment-card {
    transition: transform 0.2s;
    border: 1px solid #e0e0e0;
}

.investment-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}
</style>
