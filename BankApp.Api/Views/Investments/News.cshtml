@model IEnumerable<BankApp.Core.Models.InvestmentNews>
@{
    ViewData["Title"] = "Investment News";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>Investment News & Market Updates</h2>
            <p class="text-muted">Stay informed with the latest market news and investment insights</p>
        </div>
    </div>

    @if (ViewBag.FeaturedNews != null)
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <h3>Featured News</h3>
                <div class="row">
                    @foreach (var news in ViewBag.FeaturedNews)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card featured-news-card">
                                @if (!string.IsNullOrEmpty(news.ImageUrl))
                                {
                                    <img src="@news.ImageUrl" class="card-img-top" alt="@news.Title" style="height: 200px; object-fit: cover;">
                                }
                                <div class="card-body">
                                    <h6 class="card-title">@news.Title</h6>
                                    <p class="card-text small">@news.Summary</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">@news.PublishedAt.ToString("MMM dd, yyyy")</small>
                                        <a asp-action="NewsDetails" asp-route-id="@news.Id" class="btn btn-sm btn-primary">Read More</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <h3>Latest News</h3>
            <div class="news-list">
                @foreach (var news in Model)
                {
                    <div class="card mb-3 news-item">
                        <div class="card-body">
                            <div class="row">
                                @if (!string.IsNullOrEmpty(news.ImageUrl))
                                {
                                    <div class="col-md-3">
                                        <img src="@news.ImageUrl" class="img-fluid rounded" alt="@news.Title">
                                    </div>
                                }
                                <div class="@(string.IsNullOrEmpty(news.ImageUrl) ? "col-md-12" : "col-md-9")">
                                    <h5 class="card-title">
                                        <a asp-action="NewsDetails" asp-route-id="@news.Id" class="text-decoration-none">
                                            @news.Title
                                        </a>
                                        @if (news.IsFeatured)
                                        {
                                            <span class="badge bg-warning text-dark ms-2">Featured</span>
                                        }
                                    </h5>
                                    <p class="card-text text-muted small">
                                        <span class="me-3"><i class="fas fa-newspaper"></i> @news.Source</span>
                                        <span class="me-3"><i class="fas fa-tag"></i> @news.Category</span>
                                        <span><i class="fas fa-eye"></i> @news.ViewCount views</span>
                                    </p>
                                    <p class="card-text">@news.Summary</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">@news.PublishedAt.ToString("MMMM dd, yyyy HH:mm")</small>
                                        <a asp-action="NewsDetails" asp-route-id="@news.Id" class="btn btn-sm btn-outline-primary">Read Full Article</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Market Categories</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <a href="#" class="list-group-item list-group-item-action">
                            <i class="fas fa-chart-line text-primary"></i> Market News
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <i class="fas fa-chart-bar text-success"></i> Stock Updates
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <i class="fas fa-coins text-warning"></i> Economic Indicators
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <i class="fas fa-building text-info"></i> Company News
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <i class="fas fa-lightbulb text-secondary"></i> Investment Tips
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Quick Stats</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <h4 class="text-success">+2.3%</h4>
                            <small>S&P 500 Today</small>
                        </div>
                        <div class="col-6">
                            <h4 class="text-danger">-0.8%</h4>
                            <small>DOW Today</small>
                        </div>
                    </div>
                    <hr>
                    <div class="row text-center">
                        <div class="col-6">
                            <h4 class="text-success">+1.2%</h4>
                            <small>NASDAQ Today</small>
                        </div>
                        <div class="col-6">
                            <h4 class="text-warning">3.5%</h4>
                            <small>10Y Treasury</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.featured-news-card {
    transition: transform 0.2s;
}

.featured-news-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.news-item {
    transition: background-color 0.2s;
}

.news-item:hover {
    background-color: #f8f9fa;
}

.news-item .card-title a {
    color: inherit;
}

.news-item .card-title a:hover {
    color: #007bff;
}
</style>
