@{
    ViewData["Title"] = "Welcome to BankApp";
}

<section class="hero">
    <div class="container">
        <h1>Welcome to BankApp</h1>
        <p>Your secure and reliable online banking solution. Manage your accounts, transfer funds, and track transactions all in one place.</p>
        <div class="hero-buttons">
            <a href="/Home/SignUp" class="btn btn-secondary btn-large">Sign Up</a>
            <a href="/Home/Login" class="btn btn-primary btn-large">Login</a>
        </div>
    </div>
</section>

<section class="features">
    <div class="container">
        <h2>Why Choose BankApp?</h2>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon">🔒</div>
                <h3>Secure Banking</h3>
                <p>Your data is protected with industry-standard encryption and security measures.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <h3>Instant Transfers</h3>
                <p>Send and receive money instantly between accounts with zero delays.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📱</div>
                <h3>24/7 Access</h3>
                <p>Access your accounts anytime, anywhere from any device.</p>
            </div>
        </div>
    </div>
</section>
