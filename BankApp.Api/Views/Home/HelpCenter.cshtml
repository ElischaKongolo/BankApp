@{
    ViewData["Title"] = "Help Center";
}

<div class="support-container">
    <div class="container">
        <div class="page-header text-center">
            <h1>📚 Help Center</h1>
            <p>How can we help you today?</p>
        </div>
        
        <div class="search-box">
            <input type="text" class="form-control form-control-lg" placeholder="Search for articles, guides, and FAQs..." />
        </div>

        <div class="faq-grid">
            <div class="faq-card">
                <h3>💳 Accounts & Cards</h3>
                <ul>
                    <li><a href="#">How to open a new account?</a></li>
                    <li><a href="#">What to do if my card is lost?</a></li>
                    <li><a href="#">How to check my bank statement?</a></li>
                </ul>
            </div>
            
            <div class="faq-card">
                <h3>💸 Transfers & Payments</h3>
                <ul>
                    <li><a href="#">How long does a transfer take?</a></li>
                    <li><a href="#">Why did my payment fail?</a></li>
                    <li><a href="#">Can I transfer internationally?</a></li>
                </ul>
            </div>
            
            <div class="faq-card">
                <h3>🔒 Security</h3>
                <ul>
                    <li><a href="#">How to change my password?</a></li>
                    <li><a href="#">Enable Two-Factor Authentication</a></li>
                    <li><a href="#">Report suspicious activity</a></li>
                </ul>
            </div>
        </div>

        <div class="contact-prompt text-center">
            <p>Can't find what you're looking for?</p>
            <a href="/Home/ContactSupport" class="btn btn-primary">Contact Support</a>
        </div>
    </div>
</div>

<style>
    .support-container {
        padding: 40px 0;
        background: var(--bg-color);
        min-height: calc(100vh - 200px);
    }
    .page-header { margin-bottom: 30px; }
    .page-header h1 { font-size: 32px; font-weight: 700; margin-bottom: 10px; }
    .page-header p { color: var(--text-secondary); font-size: 18px; }
    .text-center { text-align: center; }
    
    .search-box {
        max-width: 600px;
        margin: 0 auto 40px auto;
    }
    .search-box input {
        border-radius: 30px;
        padding: 15px 25px;
        border: 2px solid var(--border-color);
        box-shadow: var(--shadow);
    }
    .search-box input:focus {
        border-color: var(--primary-color);
    }
    
    .faq-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        margin-bottom: 50px;
    }
    
    .faq-card {
        background: var(--card-bg);
        padding: 30px;
        border-radius: 16px;
        box-shadow: var(--shadow);
    }
    .faq-card h3 {
        margin-bottom: 20px;
        color: var(--primary-color);
        font-size: 20px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 10px;
    }
    .faq-card ul {
        list-style: none;
        padding: 0;
    }
    .faq-card li {
        margin-bottom: 12px;
    }
    .faq-card a {
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 500;
        transition: color 0.2s;
    }
    .faq-card a:hover {
        color: var(--primary-color);
    }
    
    .contact-prompt {
        background: var(--card-bg);
        padding: 30px;
        border-radius: 16px;
        max-width: 500px;
        margin: 0 auto;
        box-shadow: var(--shadow);
    }
    .contact-prompt p {
        margin-bottom: 15px;
        font-size: 16px;
        font-weight: 500;
    }
</style>
