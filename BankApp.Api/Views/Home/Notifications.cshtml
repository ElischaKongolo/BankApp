@model List<BankApp.Core.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var unreadCount = ViewBag.UnreadCount ?? 0;
}

<div class="notifications-container">
    <div class="container">
        <div class="page-header">
            <h1>🔔 Notifications</h1>
            <p>Stay updated with your account activity</p>
        </div>

        <div class="notifications-layout">
            <!-- Notifications List -->
            <div class="notifications-main">
                <!-- Actions Bar -->
                <div class="notifications-actions">
                    <div class="filter-tabs">
                        <button class="tab-btn active" onclick="filterNotifications('all')">All</button>
                        <button class="tab-btn" onclick="filterNotifications('unread')">Unread (@unreadCount)</button>
                    </div>
                    @if (unreadCount > 0)
                    {
                        <form asp-action="MarkAllNotificationsAsRead" asp-controller="Home" method="post" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-mark-all">Mark all as read</button>
                        </form>
                    }
                </div>

                <!-- Notifications List -->
                <div class="notifications-list">
                    @if (Model.Any())
                    {
                        foreach (var notification in Model.OrderByDescending(n => n.CreatedAt))
                        {
                            <div class="notification-card @(notification.Status == BankApp.Core.Models.NotificationStatus.Unread ? "unread" : "") @notification.Type.ToString().ToLower()" data-status="@(notification.Status == BankApp.Core.Models.NotificationStatus.Unread ? "unread" : "read")">
                                <div class="notification-icon" style="background: @notification.BackgroundColor; color: @notification.TextColor;">
                                    @notification.Icon
                                </div>
                                <div class="notification-content">
                                    <div class="notification-header">
                                        <h3>@notification.Title</h3>
                                        <span class="notification-time">@notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    <p class="notification-message">@notification.Message</p>
                                    @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                    {
                                        <a href="@notification.ActionUrl" class="notification-action">@notification.ActionText</a>
                                    }
                                </div>
                                <div class="notification-actions">
                                    @if (notification.Status == BankApp.Core.Models.NotificationStatus.Unread)
                                    {
                                        <form asp-action="MarkNotificationAsRead" asp-controller="Home" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="notificationId" value="@notification.Id" />
                                            <button type="submit" class="btn-icon" title="Mark as read">✓</button>
                                        </form>
                                    }
                                    <form asp-action="DeleteNotification" asp-controller="Home" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this notification?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="notificationId" value="@notification.Id" />
                                        <button type="submit" class="btn-icon delete" title="Delete">🗑️</button>
                                    </form>
                                </div>
                                @if (notification.IsImportant)
                                {
                                    <span class="important-badge">📌</span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-notifications">
                            <div class="empty-icon">🔔</div>
                            <h3>No Notifications</h3>
                            <p>You're all caught up! Check back later for updates.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="notifications-sidebar">
                <div class="stats-card">
                    <h3>📊 Notification Stats</h3>
                    <div class="stat-item">
                        <span class="label">Total</span>
                        <span class="value">@Model.Count</span>
                    </div>
                    <div class="stat-item">
                        <span class="label">Unread</span>
                        <span class="value">@unreadCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="label">Important</span>
                        <span class="value">@Model.Count(n => n.IsImportant)</span>
                    </div>
                </div>

                <div class="notification-types">
                    <h3>📑 By Type</h3>
                    @foreach (var type in Enum.GetValues<BankApp.Core.Models.NotificationType>())
                    {
                        var count = Model.Count(n => n.Type == type);
                        if (count > 0)
                        {
                            <div class="type-item">
                                <span class="type-icon">@GetTypeIcon(type)</span>
                                <span class="type-name">@type</span>
                                <span class="type-count">@count</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetTypeIcon(BankApp.Core.Models.NotificationType type)
    {
        return type switch
        {
            BankApp.Core.Models.NotificationType.Success => "✅",
            BankApp.Core.Models.NotificationType.Warning => "⚠️",
            BankApp.Core.Models.NotificationType.Alert => "🚨",
            BankApp.Core.Models.NotificationType.Transaction => "💸",
            BankApp.Core.Models.NotificationType.Account => "💳",
            BankApp.Core.Models.NotificationType.Security => "🔒",
            BankApp.Core.Models.NotificationType.Promotion => "🎁",
            _ => "ℹ️"
        };
    }
}

<script>
    function filterNotifications(filter) {
        // Update active tab
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');

        // Filter notifications
        const cards = document.querySelectorAll('.notification-card');
        cards.forEach(card => {
            if (filter === 'all' || card.dataset.status === filter) {
                card.style.display = 'flex';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>

<style>
    .notifications-container {
        padding: 40px 0;
        background: var(--bg-color);
        min-height: calc(100vh - 200px);
    }

    .page-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .page-header h1 {
        font-size: 32px;
        margin-bottom: 8px;
    }

    .page-header p {
        color: var(--text-secondary);
    }

    .notifications-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 768px) {
        .notifications-layout {
            grid-template-columns: 1fr;
        }
    }

    .notifications-main {
        background: var(--card-bg);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .notifications-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-color);
    }

    .filter-tabs {
        display: flex;
        gap: 8px;
    }

    .tab-btn {
        padding: 8px 16px;
        border: none;
        background: none;
        color: var(--text-secondary);
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        border-radius: 8px;
        transition: all 0.2s;
    }

    .tab-btn.active {
        background: var(--primary-color);
        color: white;
    }

    .tab-btn:hover:not(.active) {
        background: var(--bg-color);
    }

    .btn-mark-all {
        padding: 8px 16px;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
    }

    .notifications-list {
        padding: 16px;
    }

    .notification-card {
        display: flex;
        gap: 16px;
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 12px;
        position: relative;
        transition: background 0.2s;
    }

    .notification-card.unread {
        background: var(--bg-color);
        border-left: 3px solid var(--primary-color);
    }

    .notification-card.read {
        opacity: 0.8;
    }

    .notification-card:hover {
        background: var(--border-color);
    }

    .notification-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .notification-content {
        flex: 1;
    }

    .notification-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 4px;
    }

    .notification-header h3 {
        font-size: 16px;
        font-weight: 600;
    }

    .notification-time {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .notification-message {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.5;
    }

    .notification-action {
        display: inline-block;
        margin-top: 8px;
        color: var(--primary-color);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
    }

    .notification-action:hover {
        text-decoration: underline;
    }

    .notification-actions {
        display: flex;
        gap: 8px;
        opacity: 0;
        transition: opacity 0.2s;
    }

    .notification-card:hover .notification-actions {
        opacity: 1;
    }

    .important-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        font-size: 14px;
    }

    .empty-notifications {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-icon {
        font-size: 64px;
        margin-bottom: 16px;
    }

    .empty-notifications h3 {
        font-size: 18px;
        margin-bottom: 8px;
    }

    .empty-notifications p {
        color: var(--text-secondary);
    }

    .notifications-sidebar {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .stats-card, .notification-types {
        background: var(--card-bg);
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--shadow);
    }

    .stats-card h3, .notification-types h3 {
        font-size: 16px;
        margin-bottom: 16px;
    }

    .stat-item {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .stat-item:last-child {
        border-bottom: none;
    }

    .stat-item .label {
        font-size: 14px;
        color: var(--text-secondary);
    }

    .stat-item .value {
        font-size: 14px;
        font-weight: 600;
    }

    .type-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .type-item:last-child {
        border-bottom: none;
    }

    .type-icon {
        font-size: 20px;
    }

    .type-name {
        flex: 1;
        font-size: 14px;
    }

    .type-count {
        font-size: 14px;
        font-weight: 600;
        background: var(--bg-color);
        padding: 4px 8px;
        border-radius: 8px;
    }
</style>
