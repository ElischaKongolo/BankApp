@model BankApp.Core.Models.Account

@{
    ViewData["Title"] = $"{Model.AccountType} Account Details";
    var paymentMethods = ViewBag.PaymentMethods as List<BankApp.Core.Models.PaymentMethod> ?? new List<BankApp.Core.Models.PaymentMethod>();
}

<div class="account-details-container">
    <div class="container">
        <div class="page-header">
            <a href="/Home/Accounts" class="back-link">← Back to Accounts</a>
            <h1>@Model.AccountType Account</h1>
        </div>

        <!-- Account Summary Card -->
        <div class="account-summary-card">
            <div class="account-header-section">
                <div class="account-type-badge @Model.AccountType.ToString().ToLower()">
                    @(Model.AccountType == BankApp.Core.Models.AccountType.Checking ? "💳" :
                      Model.AccountType == BankApp.Core.Models.AccountType.Savings ? "🏦" : "🏢")
                </div>
                <div class="account-title">
                    <h2>@Model.AccountType Account</h2>
                    <p class="account-number">@Model.AccountNumber</p>
                </div>
                <span class="status-badge @Model.Status.ToString().ToLower()">@Model.Status</span>
            </div>

            <div class="balance-section">
                <div class="balance-item">
                    <span class="label">Current Balance</span>
                    <span class="amount">@Model.Balance.ToString("C")</span>
                </div>
                <div class="balance-item">
                    <span class="label">Available Balance</span>
                    <span class="amount available">@Model.AvailableBalance.ToString("C")</span>
                </div>
            </div>

            <div class="account-info-grid">
                <div class="info-item">
                    <span class="label">Daily Transfer Limit</span>
                    <span class="value">@Model.DailyTransferLimit.ToString("C")</span>
                </div>
                <div class="info-item">
                    <span class="label">Monthly Transfer Limit</span>
                    <span class="value">@Model.MonthlyTransferLimit.ToString("C")</span>
                </div>
                <div class="info-item">
                    <span class="label">Account Opened</span>
                    <span class="value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
            </div>

            <div class="account-actions-bar">
                <a href="/Home/Transactions" class="btn-primary">
                    <span>💸</span> Send Money
                </a>
                <a href="/Home/Dashboard" class="btn-secondary">
                    <span>📊</span> View Dashboard
                </a>
            </div>

            <!-- Delete Account Section -->
            @if (Model.Balance == 0)
            {
                <div class="delete-account-section">
                    <hr class="section-divider" />
                    <div class="delete-account-warning">
                        <h3>⚠️ Delete Account</h3>
                        <p>This action cannot be undone. Your account will be permanently deleted.</p>
                        <form asp-action="DeleteAccount" asp-controller="Home" method="post" onsubmit="return confirm('Are you absolutely sure you want to delete this account? This action cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="accountId" value="@Model.Id" />
                            <button type="submit" class="btn-delete-account">
                                <span>🗑️</span> Delete Account
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="delete-account-section">
                    <hr class="section-divider" />
                    <div class="delete-account-info">
                        <h3>🗑️ Delete Account</h3>
                        <p>To delete this account, please transfer or withdraw your remaining balance of @Model.Balance.ToString("C") first.</p>
                        <a href="/Home/Transactions" class="btn-secondary">
                            <span>💸</span> Transfer Funds
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="two-column-layout">
            <!-- Payment Methods Section -->
            <div class="payment-methods-section">
                <div class="section-header">
                    <h2>💳 Payment Methods</h2>
                    <button type="button" class="btn-add" onclick="togglePaymentForm()">
                        <span>+</span> Add Payment Method
                    </button>
                </div>

                <!-- Add Payment Method Form -->
                <div id="addPaymentForm" class="payment-form" style="display: none;">
                    <h3>Add New Payment Method</h3>
                    <form asp-action="AddPaymentMethod" asp-controller="Home" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AccountId" value="@Model.Id" />

                        <div class="form-row">
                            <div class="form-group">
                                <label>Method Name</label>
                                <input type="text" name="Name" class="form-control" placeholder="e.g., My Debit Card" required />
                            </div>
                            <div class="form-group">
                                <label>Type</label>
                                <select name="Type" class="form-control" required>
                                    <option value="">Select Type...</option>
                                    <option value="DebitCard">💳 Debit Card</option>
                                    <option value="CreditCard">💎 Credit Card</option>
                                    <option value="DirectDebit">📋 Direct Debit</option>
                                    <option value="StandingOrder">📅 Standing Order</option>
                                    <option value="BankTransfer">🏦 Bank Transfer</option>
                                    <option value="MobilePayment">📱 Mobile Payment</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row card-fields">
                            <div class="form-group">
                                <label>Card Number</label>
                                <input type="text" name="CardNumber" class="form-control" placeholder="****-****-****-****" maxlength="20" />
                            </div>
                            <div class="form-group">
                                <label>Expiry Date</label>
                                <input type="month" name="ExpiryDate" class="form-control" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Daily Limit</label>
                                <input type="number" name="DailyLimit" class="form-control" value="5000" min="0" step="100" />
                            </div>
                            <div class="form-group">
                                <label>Transaction Limit</label>
                                <input type="number" name="TransactionLimit" class="form-control" value="2500" min="0" step="100" />
                            </div>
                        </div>

                        <div class="form-group checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="IsDefault" value="true" />
                                <span>Set as default payment method</span>
                            </label>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-primary">Add Payment Method</button>
                            <button type="button" class="btn-secondary" onclick="togglePaymentForm()">Cancel</button>
                        </div>
                    </form>
                </div>

                <!-- Payment Methods List -->
                <div class="payment-methods-list">
                    @if (paymentMethods.Any())
                    {
                        foreach (var method in paymentMethods)
                        {
                            <div class="payment-method-card @(method.IsDefault ? "default" : "") @(method.Status.ToString().ToLower())">
                                @if (method.IsDefault)
                                {
                                    <span class="default-badge">⭐ Default</span>
                                }
                                <div class="method-icon @method.Type.ToString().ToLower()">
                                    @(method.Type == BankApp.Core.Models.PaymentMethodType.DebitCard ? "💳" :
                                      method.Type == BankApp.Core.Models.PaymentMethodType.CreditCard ? "💎" :
                                      method.Type == BankApp.Core.Models.PaymentMethodType.DirectDebit ? "📋" :
                                      method.Type == BankApp.Core.Models.PaymentMethodType.StandingOrder ? "📅" :
                                      method.Type == BankApp.Core.Models.PaymentMethodType.BankTransfer ? "🏦" : "📱")
                                </div>
                                <div class="method-info">
                                    <h4>@method.Name</h4>
                                    <p class="method-type">@method.Type</p>
                                    @if (!string.IsNullOrEmpty(method.CardNumber))
                                    {
                                        <p class="card-number">@method.MaskedCardNumber</p>
                                    }
                                    <p class="method-limits">Daily: @method.DailyLimit.ToString("C") | Transaction: @method.TransactionLimit.ToString("C")</p>
                                </div>
                                <div class="method-actions">
                                    @if (!method.IsDefault)
                                    {
                                        <form asp-action="SetDefaultPaymentMethod" asp-controller="Home" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="paymentMethodId" value="@method.Id" />
                                            <input type="hidden" name="accountId" value="@Model.Id" />
                                            <button type="submit" class="btn-icon" title="Set as Default">⭐</button>
                                        </form>
                                    }
                                    <form asp-action="RemovePaymentMethod" asp-controller="Home" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to remove this payment method?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentMethodId" value="@method.Id" />
                                        <input type="hidden" name="accountId" value="@Model.Id" />
                                        <button type="submit" class="btn-icon delete" title="Remove">🗑️</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-payment-methods">
                            <div class="empty-icon">💳</div>
                            <p>No payment methods added yet.</p>
                            <button type="button" class="btn-add" onclick="togglePaymentForm()">Add your first payment method</button>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="quick-stats-section">
                <h3>📊 Account Stats</h3>
                <div class="stat-card">
                    <span class="stat-label">Payment Methods</span>
                    <span class="stat-value">@paymentMethods.Count</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Default Method</span>
                    <span class="stat-value">@(paymentMethods.FirstOrDefault(pm => pm.IsDefault)?.Name ?? "None")</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Active Methods</span>
                    <span class="stat-value">@paymentMethods.Count(pm => pm.Status == BankApp.Core.Models.PaymentMethodStatus.Active)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePaymentForm() {
        var form = document.getElementById('addPaymentForm');
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }
</script>

<style>
    .account-details-container {
        padding: 40px 0;
        background: var(--bg-color);
        min-height: calc(100vh - 200px);
    }

    .page-header {
        margin-bottom: 24px;
    }

    .back-link {
        display: inline-block;
        color: var(--text-secondary);
        text-decoration: none;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .back-link:hover {
        color: var(--primary-color);
    }

    .page-header h1 {
        font-size: 28px;
    }

    .account-summary-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: var(--shadow);
        border-top: 4px solid var(--primary-color);
    }

    .account-summary-card.checking { border-top-color: #2563eb; }
    .account-summary-card.savings { border-top-color: #10b981; }
    .account-summary-card.business { border-top-color: #f59e0b; }

    .account-header-section {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--border-color);
    }

    .account-type-badge {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        background: var(--bg-color);
    }

    .account-title {
        flex: 1;
    }

    .account-title h2 {
        font-size: 20px;
        margin-bottom: 4px;
    }

    .account-number {
        font-size: 14px;
        color: var(--text-secondary);
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
    }

    .status-badge.active { background: #d1fae5; color: #065f46; }

    .balance-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 24px;
        margin-bottom: 24px;
    }

    .balance-item {
        display: flex;
        flex-direction: column;
    }

    .balance-item .label {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }

    .balance-item .amount {
        font-size: 32px;
        font-weight: 700;
    }

    .balance-item .amount.available {
        color: #10b981;
    }

    .account-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
        padding: 20px;
        background: var(--bg-color);
        border-radius: 12px;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

    .info-item .label {
        font-size: 12px;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }

    .info-item .value {
        font-size: 16px;
        font-weight: 600;
    }

    .account-actions-bar {
        display: flex;
        gap: 12px;
    }

    .two-column-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 768px) {
        .two-column-layout {
            grid-template-columns: 1fr;
        }
    }

    .payment-methods-section {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: var(--shadow);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .section-header h2 {
        font-size: 18px;
    }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
    }

    .payment-form {
        background: var(--bg-color);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .payment-form h3 {
        font-size: 16px;
        margin-bottom: 16px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 12px;
    }

    @@media (max-width: 480px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }

    .checkbox-group {
        margin: 16px 0;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 16px;
    }

    .payment-methods-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .payment-method-card {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px;
        border: 2px solid var(--border-color);
        border-radius: 12px;
        position: relative;
    }

    .payment-method-card.default {
        border-color: #f59e0b;
        background: #fffbeb;
    }

    .default-badge {
        position: absolute;
        top: -10px;
        right: 12px;
        background: #f59e0b;
        color: white;
        padding: 2px 8px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 500;
    }

    .method-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        background: var(--bg-color);
    }

    .method-info {
        flex: 1;
    }

    .method-info h4 {
        font-size: 16px;
        margin-bottom: 2px;
    }

    .method-type {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .card-number {
        font-size: 13px;
        color: var(--text-primary);
        font-family: monospace;
    }

    .method-limits {
        font-size: 11px;
        color: var(--text-secondary);
        margin-top: 4px;
    }

    .method-actions {
        display: flex;
        gap: 8px;
    }

    .btn-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: none;
        background: var(--bg-color);
        cursor: pointer;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-icon:hover {
        background: var(--border-color);
    }

    .btn-icon.delete:hover {
        background: #fee2e2;
    }

    .empty-payment-methods {
        text-align: center;
        padding: 40px;
    }

    .empty-icon {
        font-size: 48px;
        margin-bottom: 12px;
    }

    .quick-stats-section {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: var(--shadow);
        height: fit-content;
    }

    .quick-stats-section h3 {
        font-size: 16px;
        margin-bottom: 16px;
    }

    .stat-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .stat-card:last-child {
        border-bottom: none;
    }

    .stat-label {
        font-size: 14px;
        color: var(--text-secondary);
    }

    .stat-value {
        font-size: 14px;
        font-weight: 600;
    }

    /* Delete Account Section */
    .delete-account-section {
        margin-top: 24px;
    }

    .section-divider {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 24px 0;
    }

    .delete-account-warning,
    .delete-account-info {
        padding: 20px;
        border-radius: 12px;
    }

    .delete-account-warning {
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .delete-account-info {
        background: var(--bg-color);
        border: 1px solid var(--border-color);
    }

    [data-theme="dark"] .delete-account-warning {
        background: #450a0a;
        border-color: #7f1d1d;
    }

    .delete-account-warning h3,
    .delete-account-info h3 {
        font-size: 16px;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .delete-account-warning h3 {
        color: #dc2626;
    }

    .delete-account-warning p,
    .delete-account-info p {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 16px;
    }

    .btn-delete-account {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

    .btn-delete-account:hover {
        background: #991b1b;
        transform: translateY(-1px);
    }
</style>
