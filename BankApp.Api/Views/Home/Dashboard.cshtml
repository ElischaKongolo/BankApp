@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Dashboard";
    var accounts = ViewBag.Accounts as IEnumerable<BankApp.Core.Models.Account>;
    var transactions = ViewBag.RecentTransactions as IEnumerable<BankApp.Core.Models.Transaction>;
    var userTheme = ViewBag.UserTheme as BankApp.Core.Models.UserTheme;
}

@if (userTheme != null)
{
    <style>
        :root {
            --inapp-bg: @(userTheme.BackgroundColor);
            --inapp-panel: @(userTheme.SurfaceColor);
            --inapp-text-main: @(userTheme.TextColor);
            --inapp-text-muted: @(userTheme.TextMutedColor);
            --inapp-primary: @(userTheme.PrimaryColor);
            --inapp-primary-hover: @(userTheme.PrimaryColor);
            --inapp-success: #05CD99;
            --inapp-warning: #FFCE20;
            --inapp-danger: #EE5D50;
            --inapp-radius: 20px;
            --inapp-shadow: 0px 18px 40px rgba(112, 144, 176, 0.12);
            --inapp-gradient-1: linear-gradient(135deg, @(userTheme.SecondaryColor) 0%, @(userTheme.PrimaryColor) 100%);
            --inapp-gradient-2: linear-gradient(135deg, #05CD99 0%, #039B73 100%);
            --inapp-gradient-3: linear-gradient(135deg, #FFCE20 0%, #FF9020 100%);
            --inapp-card-1: linear-gradient(135deg, #111C44 0%, #0B1437 100%);
            --inapp-card-2: linear-gradient(135deg, @(userTheme.PrimaryColor) 0%, #3113B8 100%);
        }
    </style>
}

<div class="inapp-dashboard">
    <div class="dashboard-header">
        <div>
            <h1 class="welcome-text">Welcome back, @Context.Session.GetString("UserName")! 👋</h1>
            <p class="subtitle">Here's what's happening with your finances today.</p>
        </div>
        <div class="header-actions">
            <a href="/Home/DownloadReport" class="btn-modern btn-outline">Download Report</a>
            <a href="/Home/Transactions" class="btn-modern btn-primary">+ Send Money</a>
        </div>
    </div>
    
    <!-- Summary Cards -->
    <div class="metrics-grid">
        <div class="metric-card gradient-primary">
            <div class="metric-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="metric-content">
                <p class="metric-label">Total Balance</p>
                <h3 class="metric-value">@ViewBag.TotalBalance.ToString("C")</h3>
                <span class="metric-trend positive">↑ 2.5% from last month</span>
            </div>
            <div class="card-bg-shape"></div>
        </div>
        
        <div class="metric-card gradient-success">
            <div class="metric-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-3 9L9 3l-3 9H2"></path></svg>
            </div>
            <div class="metric-content">
                <p class="metric-label">E-Wallet Balance</p>
                <h3 class="metric-value">@(ViewBag.EWalletBalance?.ToString("C") ?? "R0.00")</h3>
                <span class="metric-trend positive">Digital funds available</span>
            </div>
            <div class="card-bg-shape"></div>
        </div>
        
        <div class="metric-card gradient-success">
            <div class="metric-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            </div>
            <div class="metric-content">
                <p class="metric-label">Active Accounts</p>
                <h3 class="metric-value">@ViewBag.AccountCount</h3>
                <span class="metric-trend neutral">→ 0% from last month</span>
            </div>
            <div class="card-bg-shape"></div>
        </div>
        
        <div class="metric-card gradient-warning">
            <div class="metric-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div class="metric-content">
                <p class="metric-label">Monthly Spending</p>
                <h3 class="metric-value">$1,245.00</h3>
                <span class="metric-trend negative">↓ 1.2% from last month</span>
            </div>
            <div class="card-bg-shape"></div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="content-grid">
        
        <!-- Left Column: Accounts -->
        <div class="dashboard-panel accounts-panel">
            <div class="panel-header">
                <h2>My Cards & Accounts</h2>
                <a href="/Home/Accounts" class="btn-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg></a>
            </div>
            
            <div class="accounts-wrapper">
                @if (accounts != null && accounts.Any())
                {
                    foreach (var account in accounts)
                    {
                        <div class="credit-card-mock @(account.AccountType.ToString().ToLower() == "savings" ? "card-savings" : "card-checking")">
                            <div class="card-top">
                                <span class="card-type">@account.AccountType</span>
                                <svg class="chip-icon" viewBox="0 0 36 24" fill="none"><rect width="36" height="24" rx="4" fill="#FFD700" fill-opacity="0.8"/><path d="M12 0v24M24 0v24M0 12h36" stroke="#B8860B" stroke-width="1"/></svg>
                            </div>
                            <div class="card-middle">
                                <span class="acc-num">**** **** **** @account.AccountNumber.Substring(account.AccountNumber.Length - 4)</span>
                            </div>
                            <div class="card-bottom">
                                <div class="card-balance">
                                    <span class="lbl">Balance</span>
                                    <span class="val">@account.Balance.ToString("C")</span>
                                </div>
                                <div class="card-status @account.Status.ToString().ToLower()">
                                    @account.Status
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                        <p>No accounts found.</p>
                        <a href="/Home/Accounts" class="btn-modern btn-outline">Create Account</a>
                    </div>
                }
            </div>
        </div>
        
        <!-- Right Column: Transactions -->
        <div class="dashboard-panel transactions-panel">
            <div class="panel-header">
                <h2>Recent Transactions</h2>
                <a href="/Home/Transactions" class="link-view-all">View All</a>
            </div>
            
            <div class="transaction-list-modern">
                @if (transactions != null && transactions.Any())
                {
                    foreach (var txn in transactions)
                    {
                        <div class="txn-item">
                            <div class="txn-icon-wrapper @txn.Type.ToString().ToLower()">
                                @if (txn.Type == BankApp.Core.Models.TransactionType.Deposit)
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
                                }
                                else if (txn.Type == BankApp.Core.Models.TransactionType.Withdrawal)
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                                }
                                else
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 2.1l4 4-4 4"/><path d="M3 12.2v-2a4 4 0 0 1 4-4h13.8M7 21.9l-4-4 4-4"/><path d="M21 11.8v2a4 4 0 0 1-4 4H3.2"/></svg>
                                }
                            </div>
                            <div class="txn-info">
                                <h4 class="txn-title">@txn.Description</h4>
                                <span class="txn-date">@txn.CreatedAt.ToString("MMM dd, yyyy • hh:mm tt")</span>
                            </div>
                            <div class="txn-amount @(txn.Type == BankApp.Core.Models.TransactionType.Deposit ? "positive" : "negative")">
                                @(txn.Type == BankApp.Core.Models.TransactionType.Deposit ? "+" : "-")@txn.Amount.ToString("C")
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <p>No recent transactions</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* InApp Theme Specific Styles */
    :root {
        --inapp-bg: #f4f7fe;
        --inapp-panel: #ffffff;
        --inapp-text-main: #2b3674;
        --inapp-text-muted: #a3aed1;
        --inapp-primary: #4318FF;
        --inapp-primary-hover: #3311db;
        --inapp-success: #05CD99;
        --inapp-warning: #FFCE20;
        --inapp-danger: #EE5D50;
        --inapp-radius: 20px;
        --inapp-shadow: 0px 18px 40px rgba(112, 144, 176, 0.12);
        --inapp-gradient-1: linear-gradient(135deg, #868CFF 0%, #4318FF 100%);
        --inapp-gradient-2: linear-gradient(135deg, #05CD99 0%, #039B73 100%);
        --inapp-gradient-3: linear-gradient(135deg, #FFCE20 0%, #FF9020 100%);
        --inapp-card-1: linear-gradient(135deg, #111C44 0%, #0B1437 100%);
        --inapp-card-2: linear-gradient(135deg, #4318FF 0%, #3113B8 100%);
    }

    body {
        background-color: var(--inapp-bg);
        font-family: 'Inter', sans-serif;
    }

    .container {
        max-width: 1400px; /* Wider for dashboard */
    }

    .inapp-dashboard {
        padding: 30px 0;
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Header */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 30px;
    }

    .welcome-text {
        font-size: 34px;
        font-weight: 700;
        color: var(--inapp-text-main);
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }

    .subtitle {
        color: var(--inapp-text-muted);
        font-size: 16px;
        font-weight: 400;
    }

    .header-actions {
        display: flex;
        gap: 15px;
    }

    /* Modern Buttons */
    .btn-modern {
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-primary {
        background: var(--inapp-primary);
        color: white !important;
        box-shadow: 0 10px 20px rgba(67, 24, 255, 0.2);
        border: none;
    }

    .btn-primary:hover {
        background: var(--inapp-primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(67, 24, 255, 0.3);
    }

    .btn-outline {
        background: transparent;
        color: var(--inapp-primary);
        border: 1px solid var(--inapp-primary);
    }

    .btn-outline:hover {
        background: rgba(67, 24, 255, 0.05);
    }

    .btn-icon {
        color: var(--inapp-text-muted);
        transition: color 0.2s;
    }

    .btn-icon:hover {
        color: var(--inapp-primary);
    }

    /* Metrics Grid */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        margin-bottom: 30px;
    }

    .metric-card {
        border-radius: var(--inapp-radius);
        padding: 25px;
        color: white;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: var(--inapp-shadow);
        transition: transform 0.3s ease;
    }

    .metric-card:hover {
        transform: translateY(-5px);
    }

    .gradient-primary { background: var(--inapp-gradient-1); }
    .gradient-success { background: var(--inapp-gradient-2); }
    .gradient-warning { background: var(--inapp-gradient-3); }

    .metric-icon {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
    }

    .metric-content {
        z-index: 2;
    }

    .metric-label {
        font-size: 14px;
        font-weight: 500;
        opacity: 0.9;
        margin-bottom: 4px;
    }

    .metric-value {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .metric-trend {
        font-size: 13px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.2);
        padding: 4px 10px;
        border-radius: 20px;
    }

    .card-bg-shape {
        position: absolute;
        right: -20px;
        top: -20px;
        width: 150px;
        height: 150px;
        background: radial-gradient(circle, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
        z-index: 1;
    }

    /* Content Grid */
    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 25px;
    }

    .dashboard-panel {
        background: var(--inapp-panel);
        border-radius: var(--inapp-radius);
        padding: 30px;
        box-shadow: var(--inapp-shadow);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .panel-header h2 {
        font-size: 22px;
        font-weight: 700;
        color: var(--inapp-text-main);
        letter-spacing: -0.5px;
    }

    .link-view-all {
        color: var(--inapp-primary);
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
    }

    .link-view-all:hover {
        text-decoration: underline;
    }

    /* Credit Card Mockups */
    .accounts-wrapper {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .credit-card-mock {
        padding: 25px;
        border-radius: 20px;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        transition: transform 0.3s;
    }

    .credit-card-mock:hover {
        transform: scale(1.02);
    }

    .card-checking { background: var(--inapp-card-1); }
    .card-savings { background: var(--inapp-card-2); }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .card-type {
        font-size: 16px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .chip-icon {
        width: 40px;
    }

    .card-middle {
        margin-bottom: 25px;
    }

    .acc-num {
        font-size: 22px;
        letter-spacing: 4px;
        font-family: monospace;
    }

    .card-bottom {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .card-balance .lbl {
        display: block;
        font-size: 12px;
        opacity: 0.8;
        margin-bottom: 4px;
    }

    .card-balance .val {
        font-size: 24px;
        font-weight: 700;
    }

    .card-status {
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        background: rgba(255,255,255,0.2);
    }

    /* Transaction List */
    .transaction-list-modern {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .txn-item {
        display: flex;
        align-items: center;
        padding: 15px;
        border-radius: 16px;
        background: #f8fafc;
        transition: background 0.2s;
    }

    .txn-item:hover {
        background: #f1f5f9;
    }

    .txn-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
    }

    .txn-icon-wrapper.deposit {
        background: rgba(5, 205, 153, 0.15);
        color: var(--inapp-success);
    }

    .txn-icon-wrapper.withdrawal {
        background: rgba(238, 93, 80, 0.15);
        color: var(--inapp-danger);
    }

    .txn-icon-wrapper.transfer {
        background: rgba(67, 24, 255, 0.15);
        color: var(--inapp-primary);
    }

    .txn-info {
        flex: 1;
    }

    .txn-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--inapp-text-main);
        margin-bottom: 4px;
    }

    .txn-date {
        font-size: 13px;
        color: var(--inapp-text-muted);
        font-weight: 500;
    }

    .txn-amount {
        font-size: 16px;
        font-weight: 700;
    }

    .txn-amount.positive { color: var(--inapp-success); }
    .txn-amount.negative { color: var(--inapp-text-main); } /* Darker for negatives instead of bright red in modern themes */

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: var(--inapp-text-muted);
    }

    .empty-state svg {
        margin-bottom: 15px;
        opacity: 0.5;
    }

    .empty-state p {
        margin-bottom: 15px;
        font-weight: 500;
    }

    @@media (max-width: 992px) {
        .content-grid {
            grid-template-columns: 1fr;
        }
        
        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }
    }
</style>
