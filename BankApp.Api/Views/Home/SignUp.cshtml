@model SignUpViewModel

@{
    ViewData["Title"] = "Sign Up";
}

<section class="form-section">
    <div class="container">
        <div class="form-container">
            <div class="form-header">
                <h2>Create Your Account</h2>
                <p>Join BankApp and start managing your finances today</p>
            </div>

            <form asp-action="SignUp" asp-controller="Home" method="post">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-group">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter your first name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Surname"></label>
                    <input asp-for="Surname" class="form-control" placeholder="Enter your last name" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Number"></label>
                    <input asp-for="Number" class="form-control" placeholder="Enter your phone number" />
                    <span asp-validation-for="Number" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Address"></label>
                    <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter your address"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <div class="password-input-wrapper">
                        <input asp-for="Password" class="form-control" placeholder="Create a password" id="password" />
                        <button type="button" class="password-toggle" onclick="togglePassword('password')" title="Show/Hide Password">
                            <span id="password-icon">👁️</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <div class="password-input-wrapper">
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password" id="confirmPassword" />
                        <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword')" title="Show/Hide Password">
                            <span id="confirmPassword-icon">👁️</span>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-submit">Create Account</button>
            </form>

            <div class="form-footer">
                Already have an account? <a href="/Home/Login">Login here</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
