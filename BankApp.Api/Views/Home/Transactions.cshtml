@model SendMoneyViewModel

@{
    ViewData["Title"] = "Send Money";
    var accounts = ViewBag.Accounts as IEnumerable<BankApp.Core.Models.Account>;
}

<div class="transactions-container">
    <div class="container">
        <h1>Send Money</h1>
        
        <div class="transactions-grid">
            <!-- Send Money Form -->
            <div class="send-money-card">
                <h2>Transfer Funds</h2>
                
                <form asp-action="SendMoney" asp-controller="Home" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="validation-summary"></div>
                    
                    <div class="form-group">
                        <label asp-for="FromAccountId">From Account</label>
                        <select asp-for="FromAccountId" class="form-control">
                            <option value="">Select an account</option>
                            @if (accounts != null)
                            {
                                foreach (var account in accounts)
                                {
                                    <option value="@account.Id">@account.AccountType - @account.Balance.ToString("C")</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="FromAccountId" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="ToAccountNumber">To Account Number</label>
                        <input asp-for="ToAccountNumber" class="form-control" placeholder="Enter recipient's account number" />
                        <span asp-validation-for="ToAccountNumber" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Amount">Amount</label>
                        <div class="amount-input">
                            <span class="currency">$</span>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Description">Description (Optional)</label>
                        <input asp-for="Description" class="form-control" placeholder="What's this for?" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    
                    <button type="submit" class="btn-submit">
                        <span>🚀</span> Send Money
                    </button>
                </form>
            </div>
            
            <!-- Quick Calculator -->
            <div class="calculator-card">
                <h2>Quick Calculator</h2>
                <div class="calc-section">
                    <h3>Split Bill</h3>
                    <div class="calc-form">
                        <div class="form-group">
                            <label>Total Amount</label>
                            <input type="number" id="splitTotal" class="form-control" placeholder="0.00" step="0.01" />
                        </div>
                        <div class="form-group">
                            <label>Number of People</label>
                            <input type="number" id="splitPeople" class="form-control" placeholder="2" min="2" />
                        </div>
                        <button type="button" class="btn-calc" onclick="calculateSplit()">Calculate</button>
                        <div id="splitResult" class="calc-result"></div>
                    </div>
                </div>
                
                <div class="calc-section">
                    <h3>Currency Conversion</h3>
                    <div class="calc-form">
                        <div class="form-group">
                            <label>Amount in USD</label>
                            <input type="number" id="usdAmount" class="form-control" placeholder="0.00" step="0.01" />
                        </div>
                        <button type="button" class="btn-calc" onclick="convertCurrency()">Convert to EUR</button>
                        <div id="currencyResult" class="calc-result"></div>
                    </div>
                </div>
                
                <div class="calc-section">
                    <h3>Tip Calculator</h3>
                    <div class="calc-form">
                        <div class="form-group">
                            <label>Bill Amount</label>
                            <input type="number" id="billAmount" class="form-control" placeholder="0.00" step="0.01" />
                        </div>
                        <div class="form-group">
                            <label>Tip Percentage (%)</label>
                            <input type="number" id="tipPercent" class="form-control" placeholder="15" min="0" max="100" />
                        </div>
                        <button type="button" class="btn-calc" onclick="calculateTip()">Calculate Tip</button>
                        <div id="tipResult" class="calc-result"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function calculateSplit() {
        const total = parseFloat(document.getElementById('splitTotal').value);
        const people = parseInt(document.getElementById('splitPeople').value);
        const resultDiv = document.getElementById('splitResult');
        
        if (isNaN(total) || isNaN(people) || people < 2) {
            resultDiv.innerHTML = '<p class="text-danger">Please enter valid values</p>';
            return;
        }
        
        const perPerson = total / people;
        resultDiv.innerHTML = `
            <p>Each person pays:</p>
            <p class="calc-amount">$${perPerson.toFixed(2)}</p>
        `;
    }
    
    function convertCurrency() {
        const usd = parseFloat(document.getElementById('usdAmount').value);
        const resultDiv = document.getElementById('currencyResult');
        const rate = 0.85; // Example rate: 1 USD = 0.85 EUR
        
        if (isNaN(usd)) {
            resultDiv.innerHTML = '<p class="text-danger">Please enter a valid amount</p>';
            return;
        }
        
        const eur = usd * rate;
        resultDiv.innerHTML = `
            <p>≈ ${eur.toFixed(2)} EUR</p>
            <p class="calc-rate">Rate: 1 USD = ${rate} EUR</p>
        `;
    }
    
    function calculateTip() {
        const bill = parseFloat(document.getElementById('billAmount').value);
        const percent = parseFloat(document.getElementById('tipPercent').value);
        const resultDiv = document.getElementById('tipResult');
        
        if (isNaN(bill) || isNaN(percent)) {
            resultDiv.innerHTML = '<p class="text-danger">Please enter valid values</p>';
            return;
        }
        
        const tip = bill * (percent / 100);
        const total = bill + tip;
        resultDiv.innerHTML = `
            <p>Tip: $${tip.toFixed(2)}</p>
            <p>Total: $${total.toFixed(2)}</p>
        `;
    }
</script>

<style>
    .transactions-container {
        padding: 40px 0;
        background: var(--bg-color);
        min-height: calc(100vh - 200px);
    }

    .transactions-container h1 {
        margin-bottom: 24px;
    }

    .transactions-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 768px) {
        .transactions-grid {
            grid-template-columns: 1fr;
        }
    }

    .send-money-card,
    .calculator-card {
        background: white;
        border-radius: 16px;
        padding: 32px;
        box-shadow: var(--shadow);
    }

    .send-money-card h2,
    .calculator-card h2 {
        font-size: 20px;
        margin-bottom: 24px;
    }

    .amount-input {
        position: relative;
        display: flex;
        align-items: center;
    }

    .amount-input .currency {
        position: absolute;
        left: 16px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .amount-input input {
        padding-left: 32px;
    }

    .btn-submit {
        width: 100%;
        padding: 16px;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 18px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background 0.2s;
    }

    .btn-submit:hover {
        background: var(--primary-dark);
    }

    .calc-section {
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
    }

    .calc-section:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    .calc-section h3 {
        font-size: 16px;
        margin-bottom: 16px;
        color: var(--text-secondary);
    }

    .btn-calc {
        width: 100%;
        padding: 10px;
        background: var(--bg-color);
        color: var(--text-primary);
        border: 2px solid var(--border-color);
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-calc:hover {
        border-color: var(--primary-color);
        color: var(--primary-color);
    }

    .calc-result {
        margin-top: 12px;
        padding: 12px;
        background: var(--bg-color);
        border-radius: 8px;
        text-align: center;
    }

    .calc-amount {
        font-size: 24px;
        font-weight: 700;
        color: var(--primary-color);
    }

    .calc-rate {
        font-size: 12px;
        color: var(--text-secondary);
    }
</style>
